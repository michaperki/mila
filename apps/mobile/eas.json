{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "node": "22.23.3",
      "env": {
        "APP_VARIANT": "development"
      }
    },
    "preview": {
      "distribution": "internal",
      "node": "22.23.3",
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "node": "22.23.3",
      "channel": "production"
    }
  },
  "submit": {
    "production": {}
  }
}
